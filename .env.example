# Copy this file to ".env" (same folder) and fill in the two values from Supabase.
# The .env file is private and is never committed to git.

# Supabase dashboard > Project Settings > API > "Project URL"
VITE_SUPABASE_URL=

# Supabase dashboard > Project Settings > API > "anon" "public" key.
# (This is the PUBLIC key and is designed to be used in the browser.)
# NEVER paste the "service_role" key anywhere in this project.
VITE_SUPABASE_ANON_KEY=
